{
  "name": "careershield",
  "private": true,
  "version": "2.2.0",
  "description": "AI-exposure-aware career transition advice for Malaysian workers",
  "author": "Moztoba Mutashim Billah <moztobamutashim@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:offline": "tsc -b && vite build --mode offline",
    "preview": "vite preview --port 4173 --strictPort",
    "data": "python pipeline/build_data.py",
    "data:public": "python pipeline/build_data.py --public",
    "data:check": "python pipeline/checks/check_bundle.py",
    "data:reproduce": "python pipeline/checks/reproduce_paper.py",
    "assets": "node scripts/make-assets.cjs",
    "test": "node tests/run.cjs",
    "test:unit": "tsx tests/unit.ts",
    "test:e2e": "node tests/e2e.cjs",
    "verify": "node scripts/verify.cjs"
  },
  "dependencies": {
    "@fontsource-variable/red-hat-display": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@fontsource-variable/red-hat-text": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^11.15.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.6",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
